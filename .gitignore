# Rust / Cargo build output
**/target/
/target-review-generation/

# The local moonlight-common override is required source. Ignore only the
# standalone library lockfile; keep .cargo/config.toml and vendor sources.
/vendor/moonlight-common/Cargo.lock
**/*.rs.bk

# npm / TypeScript build output
node_modules/
dist/
/coverage/
/.nyc_output/
/.pnpm-store/
/web/api_bindings.ts
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# Release, runtime, and scratch output
/finalOutput/
/bindings/
/ignore/
/server/
*.profraw
*.profdata

# Locally unpacked build toolchains
/strawberry-perl-*/

# Environment files and credentials
.env
.env.*
!.env.example
!.env.*.example

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Editors
.vscode/
.idea/
*.swp
*.swo
*~
*.suo
*.user
*.userosscache
*.sln.docstates

# Operating systems and crash output
.DS_Store
Thumbs.db
Desktop.ini
*.dmp
*.stackdump

